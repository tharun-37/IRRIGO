# Normalise line endings in the repository, then check out per-platform.
# Without this, Windows clones rewrite every file and produce whole-file diffs.
* text=auto eol=lf

# Windows batch files need CRLF to run at all.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be line-ending translated or diffed as text.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.pptx binary
*.joblib binary
*.7z binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Datasets and the lock file stay diffable.
*.csv text eol=lf
package-lock.json text eol=lf
