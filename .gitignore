# Virtual environment (copied from the sibling MP3 tree, 475 MB).
.venv/

# Editor / agent workspace metadata
.freebuff/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Node / dashboard
frontend/node_modules/
frontend/dist/

# TypeScript incremental build state. It was tracked by accident, which put a
# machine-generated file in every commit and made a rebuild look like a source
# change. Regenerated by `tsc -b`; nothing reads it from the repository.
frontend/*.tsbuildinfo
*.tsbuildinfo

# Local corpora (43 MB of simulated seasons; regenerate with scripts/).
#
# Anchored to the repository root on purpose. An unanchored `data/` matches a
# directory called `data` at ANY depth, which silently swallowed
# `src/irrigation/data/` - the entire crop, soil and irrigation-method
# catalogue, plus the external-observation client. Those files were never tracked
# in any commit, so a fresh clone could not import `irrigation.sowing` at all and
# the backend died on startup with `ModuleNotFoundError: irrigation.data`. The
# corpus this rule is actually meant to exclude is the one at the root.
data/
!/src/irrigation/data/
