# Copy to `.env` and fill in. `.env` is gitignored; this file is tracked and
# must never contain a real key.
#
# Live weather behind the dashboard's weather card, from OpenWeather's
# current-conditions endpoint. Read by the API process only, so the key is never
# sent to the browser. Leave it unset to run without live weather: the endpoint
# reports itself unavailable and the weather card falls back to the advisory's
# own sensor values.
#
# Free tier allows 60 calls a minute. Responses are cached for
# IRRIGO_V2_OPENWEATHER_CACHE_SECONDS so open dashboards do not exhaust that.
IRRIGO_V2_OPENWEATHER_API_KEY=
